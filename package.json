{
  "name": "round-one-career",
  "main": "expo-router/entry",
  "version": "3.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:data": "tsx scripts/validate-game.ts",
    "simulate:10": "tsx scripts/simulate-ten-careers.ts",
    "soak:beta": "tsx scripts/beta-soak.ts --fast --partial=500 --complete=250",
    "soak:full": "tsx scripts/beta-soak.ts --partial=500 --complete=250",
    "major:balance": "tsx scripts/major-balance.ts --runs=500",
    "beta:stats:smoke": "tsx scripts/beta-soak.ts --fast --partial=100 --complete=10",
    "major:smoke": "tsx scripts/major-balance.ts --runs=50",
    "qa:responsive": "tsx scripts/responsive-qa.ts",
    "qa:responsive:smoke": "tsx scripts/responsive-qa.ts --smoke",
    "validate": "npm run typecheck && npm run lint && npm run test:data",
    "beta:check": "npm run validate && npm run beta:stats:smoke && npm run major:smoke && npm run build:web && npm run qa:responsive:smoke && git diff --check",
    "build:web": "expo export --platform web",
    "sync:team-logos": "node scripts/sync-team-logos.mjs"
  },
  "private": true
}
